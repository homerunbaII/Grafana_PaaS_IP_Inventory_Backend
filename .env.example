# Backend CORS allowlist. Use commas to allow multiple origins.
CORS_ALLOW_ORIGINS=http://paasmon.apps.pcicd-k8s.lguplus.co.kr

# OpenShift/Kubernetes API endpoint template.
CLUSTER_API_URL_TEMPLATE=https://api.{cluster}.lguplus.co.kr:6443

# Set to false when the cluster API certificate is trusted by the container.
CLUSTER_API_INSECURE=true

# Comma-separated cluster names available to the backend and frontend.
INVENTORY_CLUSTERS=dprsv-k8s,dprv-k8s,dprmn-k8s,dprrt-k8s,dpvs-k8s,sdprmn-paas,tprsv-k8s,eprsv-k8s,pprsv-k8s,pprv-k8s,pprmn-k8s,pprrt-k8s,ppvs-k8s,papim-paas

# JSON object mapping cluster name to service account bearer token.
CLUSTER_API_TOKENS_JSON={"dprsv-k8s":"sha256~dummy-token-dprsv-k8s","dprv-k8s":"sha256~dummy-token-dprv-k8s","dprmn-k8s":"sha256~dummy-token-dprmn-k8s","dprrt-k8s":"sha256~dummy-token-dprrt-k8s","dpvs-k8s":"sha256~dummy-token-dpvs-k8s","sdprmn-paas":"sha256~dummy-token-sdprmn-paas","tprsv-k8s":"sha256~dummy-token-tprsv-k8s","eprsv-k8s":"sha256~dummy-token-eprsv-k8s","pprsv-k8s":"sha256~dummy-token-pprsv-k8s","pprv-k8s":"sha256~dummy-token-pprv-k8s","pprmn-k8s":"sha256~dummy-token-pprmn-k8s","pprrt-k8s":"sha256~dummy-token-pprrt-k8s","ppvs-k8s":"sha256~dummy-token-ppvs-k8s","papim-paas":"sha256~dummy-token-papim-paas"}
